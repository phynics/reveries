{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reveries.dev/protocol/v1/schemas/publication-attestation.schema.json",
  "title": "Reveries V2 publication attestation (RVR-004)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "type", "author_email", "session", "created_at", "commit", "transition", "publisher"],
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "publication-attestation" },
    "author_email": { "type": "string", "format": "email", "minLength": 1 },
    "session": { "type": ["string", "null"], "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "transition": { "type": "string", "pattern": "^tr:[0-9a-f]{40}([0-9a-f]{24})?$" },
    "publisher": { "type": "string", "minLength": 1, "pattern": "^(?=.*\\S).*$" }
  },
  "description": "Minimal claim linking a published commit to its reviewed tree transition. The annotated commit is the attestation identity; it carries no independent ID."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reveries.dev/protocol/v1/schemas/occurrence.schema.json",
  "title": "Reveries V2 occurrence record (RVR-014)",
  "description": "Evidence about one occurrence of a subject. The coordinate is part of the identity, so two occurrences of one blob are two records. Applies only to the named occurrence; it never replaces universal reverie applicability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "occurrence",
    "driving_event",
    "decision",
    "impact",
    "recurrence_control",
    "alternatives",
    "sources",
    "author_email",
    "session",
    "created_at"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "occurrence"
    },
    "id": {
      "$ref": "#/$defs/occurrenceId"
    },
    "occurrence": {
      "$ref": "#/$defs/occurrenceCoordinate"
    },
    "driving_event": {
      "$ref": "#/$defs/nonemptyString"
    },
    "decision": {
      "$ref": "#/$defs/nonemptyString"
    },
    "impact": {
      "$ref": "#/$defs/nonemptyString"
    },
    "recurrence_control": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "uniqueItems": true
    },
    "author_email": {
      "type": "string",
      "format": "email",
      "minLength": 1
    },
    "session": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S).*$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "kind",
        "ref"
      ],
      "properties": {
        "relation": {
          "enum": [
            "caused-by",
            "constrained-by",
            "requested-by",
            "derived-from",
            "implements",
            "corroborated-by"
          ]
        },
        "kind": {
          "enum": [
            "commit",
            "blob",
            "tree",
            "path",
            "note",
            "git-email",
            "issue",
            "confidential-pointer"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/objectId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "path"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "commit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/objectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blob"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/objectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tree"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/objectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "confidential-pointer"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^vault:v1:[A-Za-z0-9_-]{43}$"
              }
            }
          }
        }
      ]
    },
    "occurrenceId": {
      "type": "string",
      "pattern": "^oc:[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "occurrenceCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "path",
        "subject"
      ],
      "description": "One occurrence: the revision, the path inside it, and the exact blob or tree found there. At that commit, path must hold exactly subject.",
      "properties": {
        "commit": {
          "$ref": "#/$defs/objectId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!(/|(?:.*/)\\.\\.(?:/|$))).+$",
          "description": "Repository-relative path; `.` is the root tree."
        },
        "subject": {
          "$ref": "#/$defs/objectId",
          "description": "Blob or tree object; equals the annotated subject carrying this record."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reveries.dev/protocol/v1/schemas/lineage.schema.json",
  "title": "Reveries V2 lineage edge (RVR-014)",
  "description": "An explicit durable pairing between occurrences, bound to one direct parent and one result commit. It states which subjects are related and why, and discharges nothing: every decision on a predecessor still needs its own continuation, supersession, or causal retirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "kind",
    "parent",
    "commit",
    "from",
    "to",
    "transition",
    "driving_event",
    "decision",
    "impact",
    "recurrence_control",
    "alternatives",
    "sources",
    "author_email",
    "session",
    "created_at"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "const": "lineage"
    },
    "id": {
      "$ref": "#/$defs/lineageId"
    },
    "kind": {
      "enum": [
        "preserve",
        "split",
        "merge",
        "derive",
        "retire"
      ]
    },
    "parent": {
      "$ref": "#/$defs/objectId",
      "description": "A direct parent of commit. Endpoints in `from` resolve in this revision."
    },
    "commit": {
      "$ref": "#/$defs/objectId",
      "description": "The commit that establishes this relation. Endpoints in `to` resolve in this revision, and this is the only commit the edge may authorize."
    },
    "from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/endpoint"
      },
      "description": "Predecessor occurrences at `parent`, sorted by (path, subject). Each must be an annotated subject."
    },
    "to": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/endpoint"
      },
      "description": "Successor occurrences at `commit`, sorted by (path, subject). Empty exactly for kind retire."
    },
    "transition": {
      "oneOf": [
        {
          "$ref": "#/$defs/transitionId"
        },
        {
          "type": "null"
        }
      ],
      "description": "The RVR-004 tree transition this relation belongs to, when one exists."
    },
    "driving_event": {
      "$ref": "#/$defs/nonemptyString"
    },
    "decision": {
      "$ref": "#/$defs/nonemptyString"
    },
    "impact": {
      "$ref": "#/$defs/nonemptyString"
    },
    "recurrence_control": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "uniqueItems": true
    },
    "author_email": {
      "type": "string",
      "format": "email",
      "minLength": 1
    },
    "session": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "retire"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "from": {
            "maxItems": 1
          },
          "to": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "to": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "preserve"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "from": {
            "maxItems": 1
          },
          "to": {
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "split"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "from": {
            "maxItems": 1
          },
          "to": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "merge"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "from": {
            "minItems": 2
          },
          "to": {
            "maxItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S).*$"
    },
    "objectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "kind",
        "ref"
      ],
      "properties": {
        "relation": {
          "enum": [
            "caused-by",
            "constrained-by",
            "requested-by",
            "derived-from",
            "implements",
            "corroborated-by"
          ]
        },
        "kind": {
          "enum": [
            "commit",
            "blob",
            "tree",
            "path",
            "note",
            "git-email",
            "issue"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/objectId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "path"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "at"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "commit"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/objectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blob"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/objectId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tree"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "$ref": "#/$defs/objectId"
              }
            }
          }
        }
      ]
    },
    "lineageId": {
      "type": "string",
      "pattern": "^lg:[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "transitionId": {
      "type": "string",
      "pattern": "^tr:[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "subject"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!(/|(?:.*/)\\.\\.(?:/|$))).+$"
        },
        "subject": {
          "$ref": "#/$defs/objectId"
        }
      }
    }
  }
}

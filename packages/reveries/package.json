{
  "name": "@reveries/cli",
  "version": "1.0.2",
  "description": "Git-notes engineering memory for immutable blobs and commits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phynics/reveries.git",
    "directory": "packages/reveries"
  },
  "homepage": "https://github.com/phynics/reveries#readme",
  "bugs": {
    "url": "https://github.com/phynics/reveries/issues"
  },
  "keywords": [
    "git-notes",
    "engineering-decisions",
    "agent-skills"
  ],
  "type": "module",
  "bin": {
    "reveries": "dist/src/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-transform-types --test test/**/*.test.ts",
    "test:full": "node --experimental-transform-types --test test/**/*.test.ts test/**/*.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT"
}
